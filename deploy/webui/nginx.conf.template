# nginx config for the read-only hub UI container (QUM-1349).
# Rendered at container start by nginx-unprivileged's envsubst entrypoint;
# ${SPRAWL_UIAPI_UPSTREAM} is the only injected value.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Hashed asset filenames are immutable; index.html must never be cached or
    # a deploy leaves clients pinned to a stale bundle.
    location /assets/ {
        # add_header alone, not `expires`: the two each emit a Cache-Control
        # header and the response would carry both.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Same-origin API. The trailing slash on neither side is deliberate: the
    # upstream serves the /api prefix itself, so the path passes through intact.
    # `~ ^/api(/|$)` rather than the prefix `location /api`, which would also
    # capture SPA routes like /apikeys.
    location ~ ^/api(/|$) {
        proxy_pass ${SPRAWL_UIAPI_UPSTREAM};
        proxy_http_version 1.1;
        # ⚠️ $proxy_host (the host in proxy_pass), NOT $host (the browser's).
        # This was `$host` and it broke the deployed stack: Azure Container Apps
        # fronts every app with an envoy that ROUTES BY HOST, so forwarding the
        # browser's Host — the frontend's own FQDN — matched no route and every
        # /api/* call came back "upstream connect error ... unavailable" while
        # the API itself was healthy. Any Host-routing upstream (a shared
        # ingress, a CDN origin, a virtual-hosted server) fails the same way.
        # Nothing catches it locally: the Go API ignores Host entirely, so the
        # compose stack is green either way. Assertion A22 in
        # scripts/e2e-tests/uiapi-compose.sh is what catches it.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Client-side routing: every non-file path renders the SPA shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
